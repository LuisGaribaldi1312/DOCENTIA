rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Almacenamiento de Expedientes Digitales Docentes (PDFs de CVs, Cédulas, Títulos)
    // Plan Spark de Firebase: 5 GB gratuitos
    match /teachers/{teacherId}/documents/{filename} {
      // Cualquier escuela autorizada o el maestro pueden leer los documentos
      allow read: if true;
      // Solo el maestro puede subir o modificar sus documentos
      // Límite de 15MB por archivo para PDFs de expedientes
      allow write: if request.auth != null 
                   && request.resource.size < 15 * 1024 * 1024
                   && (request.resource.contentType.matches('application/pdf') 
                       || request.resource.contentType.matches('image/.*'));
    }

    // Logos institucionales de escuelas
    match /schools/{schoolId}/{filename} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
