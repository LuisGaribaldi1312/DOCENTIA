# ========================================================
# DOCENTIA - CONFIGURACIÓN DE FIREBASE (PLAN SPARK 100% GRATUITO)
# ========================================================
# 1. Ve a https://console.firebase.google.com/
# 2. Crea un proyecto nuevo (ej. docentia-app)
# 3. En la sección "Compilación":
#    - Habilita "Cloud Firestore" (Base de datos 1 GB gratis)
#    - Habilita "Storage" (Almacenamiento de expedientes y PDFs 5 GB gratis)
#    - Habilita "Authentication" (Correo/Contraseña)
# 4. En Configuración del proyecto > General > Tus apps > Selecciona "Web" (</>)
# 5. Copia los valores y pégalos aquí abajo:

NEXT_PUBLIC_FIREBASE_API_KEY=tu_api_key_aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=docentia-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=docentia-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=docentia-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id_aqui
NEXT_PUBLIC_FIREBASE_APP_ID=tu_app_id_aqui
